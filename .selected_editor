# Generated by /usr/bin/select-editor
#
# Debian's `sensible-editor` (and anything else using sensible-utils) sources
# this file and runs the value as a command line, so the -nw matters: without
# it a bare `emacs` tries to open a GUI frame, which fails over SSH and on any
# machine with no display. This matches EDITOR/VISUAL in ~/.my_profile.
SELECTED_EDITOR="/usr/bin/emacs -nw"
