## Who you are, a file each: the name is the same everywhere, the email is
## this machine's (personal, work, ...). Change ~/.gitconfig.local.user.email
## on a machine, and this file stays the same as the one in the repo.
[include]
	path = ~/.gitconfig.local.user.name
	path = ~/.gitconfig.local.user.email

## Which editor delta's links open. ~/.gitconfig has Zed on this machine;
## for another, uncomment [delta] and ONE of the lines below it (with two, the
## last one wins). DEVBOX is this server's Host in ~/.ssh/config of the
## machine you ssh from. VS Code gets no {column}: delta leaves it unfilled,
## and VS Code would take it for part of the file name.
#[delta]
## VS Code, on this machine:
#	hyperlinks-file-link-format = "vscode://file{path}:{line}"
## On a dev server, the file opened there from Zed on the machine you ssh from:
#	hyperlinks-file-link-format = "zed://ssh/DEVBOX{path}:{line}:{column}"
## The same, from VS Code:
#	hyperlinks-file-link-format = "vscode://vscode-remote/ssh-remote+DEVBOX{path}:{line}"

## Where VS Code is the one editor allowed, for commit messages too.
#[core]
#	editor = code --wait

[include]
	path = ~/.gitconfig.signing
