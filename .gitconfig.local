# `~` is being used deliberately. git expands a leading `~` but does not expand
# ${HOME} or $HOME

[user]
	name = Ruslan Vostretsov
	email = antanta.twwk@gmail.com
	signingkey = ~/.ssh/id_ed25519_signing

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

[commit]
	gpgsign = true

[tag]
	gpgsign = true
