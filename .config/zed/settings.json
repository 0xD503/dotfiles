// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  /* Duplicated key auto-commented: "agent": {
    "default_model": {
      "provider": "ollama",
      "model": "llama3.2:latest"
    },
    "model_parameters": []
  }, */
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false
  },
  "tabs": {
    "show_diagnostics": "off",
    "file_icons": true,
    "git_status": true
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "title_bar": {
    "show_branch_status_icon": true
  },
  "status_bar": {
    "line_endings_button": true
  },
  "active_pane_modifiers": {
    "inactive_opacity": 0.7
  },
  "format_on_save": "on",
  "indent_guides": {
    "background_coloring": "disabled",
    "coloring": "indent_aware",
    "enabled": true,
  },
  "terminal": {
    "font_size": 16.0,
    "font_family": ".ZedMono",
    "scrollbar": {
      "show": "auto",
    },
  },
  "show_whitespaces": "trailing",
  "hide_mouse": "on_typing_and_action",
  "cursor_shape": "bar",
  "cursor_blink": true,
  "current_line_highlight": "all",
  "project_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
    "tree_view": false,
  },
  "colorize_brackets": true,
  "disable_ai": false,
  "toolbar": {
    "breadcrumbs": true,
    "code_actions": true,
  },
  "minimap": {
    "display_in": "all_editors",
    "show": "auto",
  },
  "edit_predictions": {
    "provider": "none",
  },
  "base_keymap": "VSCode",
  "agent": {
    "dock": "right",
    "sidebar_side": "right",
    "default_model": {
      "provider": "ollama",
      "model": "qwen2.5-coder:14b",
    },
  },
  // "base_keymap": "Emacs",
  "vim_mode": false,
  "telemetry": {
    "metrics": false,
    "diagnostics": false,
  },
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "buffer_font_features": {
    "liga": true,
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
  "soft_wrap": "prefer_line",
  "preferred_line_length": 80,
}
