[alias]
	st = status
	co = checkout
	ci = commit
	br = branch
	unload = push --all origin
	stu = status --untracked-files=no
	df = diff
	lg = log --oneline --graph
	mg = merge --no-ff
	rb = rebase
	rbc = rebase --continue
	dfc = diff --cached
	adu = add --update
	cfd = clean --force -d
	rs = restore
	rss = restore --staged
	adi = add --interactive
	cim = commit --message
	cl = clone
	ciam = commit --all --message
	rmc = rm --cached
	sw = switch
	unstash = stash pop
	cia = commit --all
	ciaa = commit --all --amend
	ptags = push --tags
	unstage = restore --staged
	cid = commit --amend
	sm = submodule
	smu = submodule update
	psm = pull --recurse-submodules
	pasm = pull --all --recurse-submodules
	fasm = fetch --all --recurse-submodules
	rst = reset
	rsts = reset --soft
	rstm = reset --mixed
	sts = stash
	stsl = stash list
	rbom = rb origin/master
	cxf = clean -X --force
	a = add
	cpc = cherry-pick --continue
	cp = cherry-pick
	cie = commit --allow-empty
	s = status
	l = log
	b = branch --verbose
	d = diff
	cn = clone
	cns = clone --recurse-submodules
	h = help
	swc = switch --create
	ciad = commit --all --amend
	cls = clone --recurse-submodules
	cfg = config --global
	sh = show
	swm = switch master
	psho = push origin
	rv = revert
	rvc = revert --continue
	hist = log --follow --patch --
	v = version
	smur = submodule update --init --recursive
	smui = submodule update --init
	rsth = rst HEAD~
	rbab = rebase --abort
	cln = clean
	clnfdxyy = clean --force -d -x
	rvsh = remote --verbose show
	clnfdx = clean --force -d -x --dry-run
	rbi = rebase --interactive
	rt = remote
	rtv = remote --verbose show
	lp = log --patch
	cpab = cherry-pick --abort
	fsm = fetch --recurse-submodules
	smuir = submodule update --init --recursive
	cidne = commit --amend --no-edit
	wt = worktree
	wta = worktree add
	wtl = worktree list --verbose
	cnb = clone --branch
	cnsb = clone --recurse-submodules --branch
	cnssb = clone --recurse-submodules --single-branch --branch
	fash = fetch --unshallow
	fdp = fetch --deepen
	ciadne = commit --all --amend --no-edit
	sl = shortlog
	sls = shortlog --summary --numbered --email
	rssa = restore --staged .
	prb = pull --rebase
	pbo = pull --rebase origin
	pbom = pull --rebase origin master
	clnall = "!git clean --force --force -d -x; git submodule foreach --recursive \"git clean --force --force -d -x\""
	speedup = !git reflog expire --expire=now --all && git pack-refs --all --prune && git gc --prune=now && git commit-graph write --reachable --changed-paths && git update-index --refresh
	pshuo = push --set-upstream origin
	plo = pull origin
	rbet = rebase --edit-todo
	fo = fetch origin
	bl = blame
	wtp = worktree prune
	dh = diff HEAD
	stshp = stash show --patch
	speedup-deep = !git reflog expire --expire=now --all && git gc --aggressive --prune=now && git commit-graph write --reachable --changed-paths
	aliases = config --get-regexp '^alias\\.'
	undo = reset --soft HEAD~1
	rvab = revert --abort
	fa = fetch --all
	pshoa = push origin --all
	taga = tag --sign --annotate
	ciassm = commit --all --signoff --gpg-sign --message
	pshoat = push origin --all --follow-tags
	cissm = commit --signoff --gpg-sign --message
	cism = commit --signoff --message
	ciasm = commit --all --signoff --message
	g = grep --perl-regexp --line-number -I
	gi = grep --perl-regexp --line-number -I --ignore-case
	gu = grep --perl-regexp --line-number -I --no-index
	giu = grep --perl-regexp --line-number -I --ignore-case --no-index
	gs = grep --perl-regexp --line-number -I --recurse-submodules
	gsi = grep --perl-regexp --line-number -I --recurse-submodules --ignore-case
	gsu = grep --perl-regexp --line-number -I --recurse-submodules --no-index
	gsiu = grep --perl-regexp --line-number -I --recurse-submodules --no-index --ignore-case
	cis = commit --signoff
	cias = commit --all --signoff
	cisf = commit --signoff --fixup
	cisfh = commit --signoff --fixup HEAD
	ciasfh = commit --all --signoff --fixup HEAD
	pltags = pull origin --tags
	cissf = commit --signoff --gpg-sign --fixup
	cissfh = commit --signoff --gpg-sign --fixup HEAD
	ciassfh = commit --all --signoff --gpg-sign --fixup HEAD
	ciassf = commit --all --signoff --gpg-sign --fixup
	mgff = merge --ff
	rtao = remote add origin
[core]
	editor = emacs -nw -q
[init]
	defaultBranch = master
[merge]
	conflictStyle = zdiff3
[diff]
	algorithm = histogram
	colorMoved = zebra
	colorMovedWS = allow-indentation-change
[branch]
	sort = -committerdate
[grep]
	lineNumber = true
	patternType = perl
	fullName = true
[pager]
	grep = false

## this setting should be last
[include]
	## settings here override and/or add-up above ones
	path = ~/.gitconfig.local
